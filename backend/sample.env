PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/travel_agency_db
FRONTEND_URL=http://localhost:3000

# Security & Tokens
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRY=7d

# Session secret
SESSION_SECRET=your_session_secret_key_here

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@viajesdominicana.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=Viajes Dominicana <no-reply@viajesdominicana.com>
